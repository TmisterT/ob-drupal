{
  "name": "ob-drupal-project",
  "description": "Root development commands for the Office of Te Beretitenti Drupal project.",
  "private": true,
  "engines": {
    "node": ">=18.0",
    "npm": ">=8.0"
  },
  "scripts": {
    "postinstall": "npm --prefix web/themes/custom/ob ci",
    "theme:install": "npm --prefix web/themes/custom/ob ci",
    "build": "npm --prefix web/themes/custom/ob run build",
    "dev": "npm --prefix web/themes/custom/ob run dev",
    "watch": "npm --prefix web/themes/custom/ob run watch",
    "lint": "npm --prefix web/themes/custom/ob run stylint",
    "format": "npm --prefix web/themes/custom/ob run stylint-fix"
  }
}
