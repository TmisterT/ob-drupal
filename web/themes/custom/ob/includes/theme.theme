<?php

/**
 * @file
 * Custom theme hooks.
 */

/**
 * Implements hook_preprocess_page().
 */
function ob_preprocess_page(array &$variables): void {
  $site_config = \Drupal::config('system.site');

  $variables['site_name'] = $site_config->get('name');
  $variables['site_slogan'] = $site_config->get('slogan');
  $variables['front_page'] = $variables['front_page'] ?? '/';
}

/**
 * Implements hook_preprocess_maintenance_page().
 */
function ob_preprocess_maintenance_page(array &$variables): void {
  // Reuse editorial contact details and social destinations during downtime.
  // Render placed blocks so their access checks and cache metadata are retained.
  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('block');
  foreach (['maintenance_contact' => 'ob_footer_contact', 'maintenance_social' => 'ob_social_menu'] as $variable => $id) {
    $block = $storage->load($id);
    if ($block && $block->status()) {
      $variables[$variable] = $view_builder->view($block);
    }
  }
}
