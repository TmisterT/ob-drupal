{# Stable container for both populated and empty inline search responses. #}
<div data-ob-search-results data-search-empty="{{ items ? 'false' : 'true' }}">
  {% if items %}
    <{{ list_type }}{{ attributes.addClass('ob-search-results') }}>
      {% for item in items %}
        <li{{ item.attributes }}>{{ item.value }}</li>
      {% endfor %}
    </{{ list_type }}>
  {% else %}
    {{ empty }}
    <p>{{ 'Try fewer words, check the spelling, or select All information to broaden your search.'|t }}</p>
  {% endif %}
</div>
