{# Branded maintenance screen using Drupal's administrator-managed message. #}
{{ attach_library('ob/style') }}
<div class="ob-maintenance">
  <header class="ob-maintenance__identity">
    <img src="/{{ directory }}/favicon.png" alt="" width="64" height="64">
    <div>
      <span class="ob-maintenance__office">{{ site_name }}</span>
      <span class="ob-maintenance__government">{{ 'Government of Kiribati'|t }}</span>
    </div>
  </header>

  <main id="main-content" class="ob-maintenance__main">
    <section class="ob-maintenance__card" aria-labelledby="maintenance-title">
      <span class="ob-maintenance__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a9 9 0 1 0 9 9M12 7v5l3 2M16 3h5v5M21 3l-5 5"/>
        </svg>
      </span>
      <span class="ob-maintenance__status"><span aria-hidden="true"></span>{{ 'Website maintenance'|t }}</span>
      <h1 id="maintenance-title">{{ 'We’ll be back soon'|t }}</h1>
      <div class="ob-maintenance__message">
        {{ page.highlighted }}
        {{ page.content }}
      </div>
      <a class="ob-maintenance__retry" href="{{ front_page }}">{{ 'Check again'|t }} <span aria-hidden="true">↻</span></a>
      {% if maintenance_contact or maintenance_social %}
        <div class="ob-maintenance__support">
          {{ maintenance_contact }}
          {{ maintenance_social }}
        </div>
      {% endif %}
    </section>
    <p class="ob-maintenance__footer">{{ site_name }} · {{ 'Government of Kiribati'|t }}</p>
  </main>
  {{ page.page_bottom }}
</div>
