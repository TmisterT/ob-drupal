{# Branded maintenance screen using Drupal's administrator-managed message. #}
{{ attach_library('ob/style') }}
<div class="ob-maintenance">
  <header class="ob-maintenance__identity">
    <img src="/{{ directory }}/favicon.png" alt="" width="64" height="64">
    <div>
      <span class="ob-maintenance__office">{{ site_name }}</span>
      <span class="ob-maintenance__government">{{ 'Government of Kiribati'|t }}</span>
    </div>
  </header>

  <main id="main-content" class="ob-maintenance__main">
    <section class="ob-maintenance__card" aria-labelledby="maintenance-title">
      <span class="ob-maintenance__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m14.7 6.3 3 3 3.6-3.6a6 6 0 0 1-7.9 7.9l-6.6 6.6a2.1 2.1 0 0 1-3-3l6.6-6.6a6 6 0 0 1 7.9-7.9l-3.6 3.6Z"/>
          <path d="m3 3 4 1 1 3-1 1-3-1-1-4ZM7.5 7.5l3 3M15 15l5.2 5.2a1.4 1.4 0 0 0 2-2L17 13"/>
        </svg>
      </span>
      <span class="ob-maintenance__status"><span aria-hidden="true"></span>{{ 'Website maintenance'|t }}</span>
      <h1 id="maintenance-title">{{ 'We’ll be back soon'|t }}</h1>
      <div class="ob-maintenance__message">
        {{ page.highlighted }}
        {{ page.content }}
      </div>
      <a class="ob-maintenance__retry" href="{{ front_page }}">{{ 'Check again'|t }} <span aria-hidden="true">↻</span></a>
      {% if maintenance_contact or maintenance_social %}
        <div class="ob-maintenance__support">
          {% if maintenance_contact %}
            <div class="ob-maintenance__contacts"{{ create_attribute({'aria-label': 'Contact'|t}) }}>
              {% if maintenance_contact.field_phone %}
                <div class="ob-maintenance__contact">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 3 3 5-3 2a14 14 0 0 0 7 7l2-3 5 3-1 4C10 22 2 14 3 4Z"/></svg>
                  <span class="visually-hidden">{{ 'Phone'|t }}</span>
                  {{ maintenance_contact.field_phone }}
                </div>
              {% endif %}
              {% if maintenance_contact.field_email %}
                <div class="ob-maintenance__contact">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
                  <span class="visually-hidden">{{ 'Email'|t }}</span>
                  {{ maintenance_contact.field_email }}
                </div>
              {% endif %}
              {{ maintenance_contact|without('field_phone', 'field_email') }}
            </div>
          {% endif %}
          {{ maintenance_social }}
        </div>
      {% endif %}
    </section>
    <p class="ob-maintenance__footer">{{ site_name }} · {{ 'Government of Kiribati'|t }}</p>
  </main>
  {{ page.page_bottom }}
</div>
