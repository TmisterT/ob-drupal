{# Social links are managed in Drupal at Structure > Menus > Social links. #}
{% if items %}
  <nav class="footer-social" aria-label="{{ 'Follow us'|t }}">
    <ul class="footer-social__list">
      {% for item in items %}
        {% set link_classes = ['footer-social__link'] %}
        {% set social_url = item.url.toString|lower %}
        {% set is_facebook = social_url matches '~^https?://([a-z0-9-]+\\.)*(facebook\\.com|fb\\.com|fb\\.me)([/?#]|$)~' %}
        {% if is_facebook %}
          {% set link_classes = link_classes|merge(['footer-social__link--facebook']) %}
        {% endif %}
        <li{{ item.attributes.addClass('footer-social__item') }}>
          <a class="{{ link_classes|join(' ') }}" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
            {% if is_facebook %}
              <svg class="footer-social__icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16 8.049C16 3.603 12.418 0 8 0S0 3.603 0 8.049c0 4.017 2.925 7.347 6.75 7.951v-5.625H4.719V8.049H6.75V6.276c0-2.017 1.194-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.994 0-1.304.621-1.304 1.258v1.509h2.219l-.355 2.326H9.25V16C13.075 15.396 16 12.066 16 8.049"/></svg>
            {% endif %}
            <span>{{ item.title }}</span>
            <span class="visually-hidden">{{ '(opens in a new tab)'|t }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
