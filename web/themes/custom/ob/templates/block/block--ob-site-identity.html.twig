{#
/**
 * @file
 * Administrator-managed government identity in the main header.
 */
#}
{% set home_url = path('<front>') %}
{% if content.field_home_link['#items'] is defined and not content.field_home_link['#items'].isEmpty %}
  {% set home_url = content.field_home_link['#items'].0.url %}
{% endif %}

<div{{ attributes.addClass('site-identity-block') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <a class="site-identity" href="{{ home_url }}" rel="home">
    <span class="site-identity__crest">
      {% if content.field_logo['#items'] is defined and not content.field_logo['#items'].isEmpty %}
        {{ content.field_logo }}
      {% else %}
        <img src="/{{ directory }}/build/assets/images/ob-government-mark.svg" alt="" width="72" height="72">
      {% endif %}
    </span>
    <span class="site-identity__copy">
      <span class="site-identity__name">{{ content.field_office_name.0 }}</span>
      <span class="site-identity__government">{{ content.field_government_name.0 }}</span>
    </span>
  </a>
</div>
