{# Full display for an administrator-managed Public Notice. #}
{% set notice_link = node.field_notice_link.0 %}
<article{{ attributes.addClass('content-page', 'public-notice-page') }}>
  {{ title_prefix }}{{ title_suffix }}
  <header class="public-notice-page__header">
    <div class="public-notice-page__meta">
      {% if node.field_notice_urgent.value %}<span class="public-notice-row__urgent">{{ 'Urgent'|t }}</span>{% endif %}
      <span>{{ content.field_notice_category }}</span>
      <time datetime="{{ node.field_notice_date.value }}">{{ node.field_notice_date.value|date('j F Y') }}</time>
    </div>
    <div class="content-page__lead">{{ content.field_notice_summary }}</div>
  </header>
  {{ content.field_featured_image }}
  <div class="content-page__body">{{ content.body }}</div>
  {{ content.field_documents }}
  {% if notice_link %}
    <div class="content-page__action"><a href="{{ notice_link.url }}">{{ notice_link.title }}</a></div>
  {% endif %}
</article>
