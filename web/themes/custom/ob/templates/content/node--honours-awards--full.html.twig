{# Full display for administrator-managed Honours & Awards content. #}
{% set has_section_nav = section_navigation.links is not empty %}
<article{{ attributes.addClass('menu-section-page', 'service-page', 'service-page--awards') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% include '@ob/templates/content/service-page--header.html.twig' %}

  <div class="menu-section-page__layout{% if not has_section_nav %} menu-section-page__layout--without-nav{% endif %}">
    {% if has_section_nav %}
      {% include '@ob/templates/navigation/section-navigation.html.twig' with {
        heading_id: 'awards-section-navigation-heading'
      } %}
    {% endif %}

    <div class="menu-section-page__content service-page__content">
      {% if service_details.body %}
        <details class="service-disclosure service-page__overview">
          <summary><span>{{ 'About honours and awards'|t }}</span><span class="service-disclosure__icon" aria-hidden="true"></span></summary>
          <div class="service-disclosure__content menu-section-page__body">{{ service_details.body }}</div>
        </details>
      {% endif %}

      {% if service_details.groups %}
        <section class="service-awards" aria-labelledby="service-awards-heading">
          <header class="service-page__section-heading">
            <p>{{ 'Official criteria'|t }}</p>
            <h2 id="service-awards-heading">{{ 'Award categories'|t }}</h2>
          </header>
          {% for group in service_details.groups %}
            <section class="award-group" aria-labelledby="award-group-{{ loop.index }}">
              <div class="award-group__heading">
                <h3 id="award-group-{{ loop.index }}">{{ group.title }}</h3>
                {% if group.description %}<div>{{ group.description }}</div>{% endif %}
              </div>
              <div class="award-group__list">
                {% for award in group.awards %}
                  <details class="award-criterion">
                    <summary class="award-criterion__summary">
                      <span class="award-criterion__number" aria-hidden="true">{{ award.number }}</span>
                      <span class="award-criterion__title">
                        <span class="award-criterion__name">{{ award.name }}</span>
                        {% if award.code %}<span class="award-criterion__code">{{ award.code }}</span>{% endif %}
                      </span>
                      <span class="service-disclosure__icon" aria-hidden="true"></span>
                    </summary>
                    {% if award.criteria %}<div class="award-criterion__text">{{ award.criteria }}</div>{% endif %}
                  </details>
                {% endfor %}
              </div>
            </section>
          {% endfor %}
        </section>
      {% endif %}

      {% if service_details.eligibility %}
        <details class="service-disclosure service-page__section">
          <summary><span>{{ 'Eligibility'|t }}</span><span class="service-disclosure__icon" aria-hidden="true"></span></summary>
          <div class="service-disclosure__content">{{ service_details.eligibility }}</div>
        </details>
      {% endif %}

      {% if service_details.requirements %}
        <details class="service-disclosure service-page__section">
          <summary><span>{{ 'Nomination requirements'|t }}</span><span class="service-disclosure__icon" aria-hidden="true"></span></summary>
          <div class="service-disclosure__content">{{ service_details.requirements }}</div>
        </details>
      {% endif %}

      {% if service_details.steps %}
        <details class="service-disclosure service-page__section service-process">
          <summary>
            <span>{{ 'Nomination process'|t }}</span>
            <span class="service-disclosure__count">{{ service_details.steps|length }} {{ 'steps'|t }}</span>
            <span class="service-disclosure__icon" aria-hidden="true"></span>
          </summary>
          <div class="service-disclosure__content">
            <ol>
              {% for step in service_details.steps %}
                <li><span aria-hidden="true">{{ step.number }}</span><div>{{ step.content }}</div></li>
              {% endfor %}
            </ol>
          </div>
        </details>
      {% endif %}

      {% if service_details.processing %}
        <details class="service-disclosure service-page__section">
          <summary><span>{{ 'Review and selection'|t }}</span><span class="service-disclosure__icon" aria-hidden="true"></span></summary>
          <div class="service-disclosure__content">{{ service_details.processing }}</div>
        </details>
      {% endif %}

      {% include '@ob/templates/content/service-page--footer.html.twig' with {
        documents_heading: 'Nomination forms and official documents'|t
      } %}
    </div>
  </div>

  {{ content|without('field_summary', 'field_service_category', 'field_audience', 'field_application_status', 'field_opening_date', 'field_closing_date', 'body', 'field_award_categories', 'field_eligibility', 'field_requirements', 'field_application_steps', 'field_processing_info', 'field_documents', 'field_service_link', 'field_contact_email', 'field_content_owner', 'field_last_reviewed') }}
</article>
