{#
/**
 * @file
 * Full display for the administrator-managed Homepage content type.
 */
#}
{% set hero_link = node.field_hero_link.0 %}
{% set quick_links = node.field_quick_links %}
{% set homepage_sections = [
  {
    id: 'updates',
    number: '01',
    heading: node.field_updates_heading.value,
    intro: content.field_updates_intro,
    has_intro: not node.field_updates_intro.isEmpty,
    link: node.field_updates_link.0,
  },
  {
    id: 'services',
    number: '02',
    heading: node.field_services_heading.value,
    intro: content.field_services_intro,
    has_intro: not node.field_services_intro.isEmpty,
    link: node.field_services_link.0,
  },
  {
    id: 'activities',
    number: '03',
    heading: node.field_activities_heading.value,
    intro: content.field_activities_intro,
    has_intro: not node.field_activities_intro.isEmpty,
    link: node.field_activities_link.0,
  },
  {
    id: 'projects',
    number: '04',
    heading: node.field_projects_heading.value,
    intro: content.field_projects_intro,
    has_intro: not node.field_projects_intro.isEmpty,
    link: node.field_projects_link.0,
  },
] %}

<article{{ attributes.addClass('homepage') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if homepage_slider %}
    {{ homepage_slider }}
  {% else %}
    <section class="homepage-hero" aria-labelledby="homepage-hero-title">
      <div class="container homepage-hero__inner">
        <div class="homepage-hero__content">
          {% if node.field_hero_label.value %}
            <div class="homepage-hero__eyebrow">{{ node.field_hero_label.value }}</div>
          {% endif %}
          <h1 id="homepage-hero-title" class="homepage-hero__title">{{ node.field_hero_title.value }}</h1>
          {% if not node.field_hero_summary.isEmpty %}
            <div class="homepage-hero__summary">{{ content.field_hero_summary }}</div>
          {% endif %}
          {% if hero_link %}
            <a class="homepage-hero__action" href="{{ hero_link.url }}">
              <span>{{ hero_link.title }}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {% endif %}
        </div>

        <div class="homepage-hero__visual{% if node.field_hero_image.isEmpty %} homepage-hero__visual--graphic{% endif %}"{% if node.field_hero_image.isEmpty %} aria-hidden="true"{% endif %}>
          {% if not node.field_hero_image.isEmpty %}
            {{ content.field_hero_image }}
          {% else %}
            <div class="homepage-hero__sun"></div>
            <div class="homepage-hero__bird"></div>
            <div class="homepage-hero__waves"></div>
          {% endif %}
        </div>
      </div>
    </section>

  {% endif %}

  <section id="site-search" class="homepage-search" aria-labelledby="homepage-search-title">
    <div class="container">
      <div class="homepage-search__panel">
        <div class="homepage-search__heading">
          <span class="homepage-search__kicker">{{ 'Government information and services'|t }}</span>
          <h2 id="homepage-search-title">{{ node.field_search_heading.value }}</h2>
        </div>
        <form id="homepage-search-form" class="homepage-search__form" action="{{ path('search.view_node_search') }}" method="get" role="search">
          <label class="visually-hidden" for="homepage-search-input">{{ node.field_search_heading.value }}</label>
          <svg class="homepage-search__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/></svg>
          <input id="homepage-search-input" name="keys" type="search" required placeholder="{{ node.field_search_placeholder.value }}">
          <label class="visually-hidden" for="homepage-search-type">{{ 'Filter by content type'|t }}</label>
          <select id="homepage-search-type" name="f[]" aria-label="{{ 'Filter by content type'|t }}">
            <option value="">{{ 'All information'|t }}</option>
            <option value="type:service">{{ 'Services'|t }}</option>
            <option value="type:publication">{{ 'Publications and gazettes'|t }}</option>
            <option value="type:update">{{ 'News and press releases'|t }}</option>
            <option value="type:public_notice">{{ 'Public notices'|t }}</option>
          </select>
          <button class="homepage-search__clear" type="reset" aria-label="{{ 'Clear search and filters'|t }}">{{ 'Clear'|t }}</button>
          <button type="submit">{{ 'Search'|t }}</button>
        </form>
      </div>
      <section class="homepage-search__results" data-homepage-search-results aria-labelledby="homepage-search-results-title" hidden>
        <h2 id="homepage-search-results-title" tabindex="-1">{{ 'Search results'|t }}</h2>
        <p data-homepage-search-status role="status" aria-live="polite"></p>
        <div data-homepage-search-content></div>
        <a data-homepage-search-fallback hidden>{{ 'Open the search results page'|t }}</a>
      </section>
    </div>
  </section>

  {% if not quick_links.isEmpty %}
    {# Icons follow destinations, independently of link order and translated labels. #}
    {% set quick_link_icons = {
      'internal:/resources/gazettes': 'M13 21H4V3h11l4 4v5M14 3v5h5M7 8h3M7 12h5M7 16h3M20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM15 18.5V22l2-1 2 1v-3.5',
      'internal:/resources/forms': 'M11 21H4V3h11l4 4v3M14 3v5h5M7 8h3M7 12h5M7 16h2M13 17l6-6 3 3-6 6-4 1zM17 13l3 3',
      'internal:/resources/information-library': 'M3 4h4v15H3zM8 4h4v15H8zM14 5l4-1 4 14-4 1zM3 8h4M8 8h4M15 9l4-1M2 21h20',
      'entity:node/42': 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM16 8l-3 5-5 3 3-5zM12 3v2M21 12h-2M12 21v-2M3 12h2',
      'internal:/news-media/press-releases': 'M4 10h5l11-5v14L9 14H4zM9 10v4M5 14l2 7h4l-2-7M2 10v4',
      'internal:/services': 'M15 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6 14v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1M2 18h5l3 2h6l6-5M8 16h6a2 2 0 0 1 2 2H11M2 22h14l6-5'
    } %}
    {% set default_quick_link_icon = 'M7 3h8l4 4v14H7zM14 3v5h5M10 12h6M10 16h6' %}
    <nav class="homepage-quick-links" aria-label="{{ 'Popular government information'|t }}">
      <div class="container">
        <div class="homepage-quick-links__header">
          <span>{{ 'Popular information'|t }}</span>
        </div>
        <div class="homepage-quick-links__grid">
          {% for item in quick_links %}
            <a class="quick-link-card" href="{{ item.url }}">
              <span class="quick-link-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="{{ quick_link_icons[item.uri]|default(default_quick_link_icon) }}"/></svg>
              </span>
              <span class="quick-link-card__label">{{ item.title }}</span>
              <svg class="quick-link-card__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {% endfor %}
        </div>
      </div>
    </nav>
  {% endif %}

  {{ official_updates_cache }}
  {% if official_updates %}
    {% include '@ob/templates/content/homepage-official-updates.html.twig' with {items: official_updates, heading: node.field_notices_heading.value} only %}
  {% endif %}

  {% if current_president %}
    <section class="homepage-president" aria-label="{{ 'Current President'|t }}">
      <div class="container">{{ current_president }}</div>
    </section>
  {% endif %}

  <section class="homepage-explore" aria-labelledby="homepage-explore-title">
    <div class="container">
      <div class="homepage-explore__heading">
        <span class="homepage-section__eyebrow">{{ 'Explore the Office'|t }}</span>
        <h2 id="homepage-explore-title">{{ 'Information for the public'|t }}</h2>
      </div>
      <div class="homepage-explore__grid">
        {% for section in homepage_sections %}
          {% if section.heading and (section.has_intro or section.link) %}
            <article class="homepage-feature homepage-feature--{{ section.id }}">
              <div class="homepage-feature__top">
                <span class="homepage-feature__number" aria-hidden="true">{{ section.number }}</span>
                <span class="homepage-feature__icon" aria-hidden="true">
                  {% if section.id == 'updates' %}
                    <svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg>
                  {% elseif section.id == 'services' %}
                    <svg viewBox="0 0 24 24"><path d="M4 21h16M6 18h12M7 9v9M12 9v9M17 9v9M5 9h14L12 3z"/></svg>
                  {% elseif section.id == 'activities' %}
                    <svg viewBox="0 0 24 24"><path d="M12 3a5 5 0 0 0-5 5v3l-2 4h14l-2-4V8a5 5 0 0 0-5-5ZM9 19h6"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24"><path d="M4 19V9l8-5 8 5v10M2 19h20M8 19v-6h8v6"/></svg>
                  {% endif %}
                </span>
              </div>
              <h3>{{ section.heading }}</h3>
              {% if section.has_intro %}
                <div class="homepage-feature__summary">{{ section.intro }}</div>
              {% endif %}
              {% if section.link %}
                <a class="homepage-feature__link" href="{{ section.link.url }}">
                  <span>{{ section.link.title }}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {{ content|without(
    'field_hero_label',
    'field_hero_title',
    'field_hero_summary',
    'field_hero_image',
    'field_hero_link',
    'field_search_heading',
    'field_search_placeholder',
    'field_quick_links',
    'field_notices_heading',
    'field_updates_heading',
    'field_updates_intro',
    'field_updates_link',
    'field_services_heading',
    'field_services_intro',
    'field_services_link',
    'field_activities_heading',
    'field_activities_intro',
    'field_activities_link',
    'field_projects_heading',
    'field_projects_intro',
    'field_projects_link'
  ) }}
</article>
