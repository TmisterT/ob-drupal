{{ attach_library('ob/gazette-slider') }}
<section class="homepage-explore gazette-section" aria-labelledby="homepage-explore-title" data-pdf-preview-group>
  <div class="container">
    <header class="gazette-section__heading">
      <div>
        <span class="homepage-section__eyebrow">{{ section_label|default('')|trim ?: 'Official publications'|t }}</span>
        <h2 id="homepage-explore-title">{{ section_heading|default('')|trim ?: 'Information for the public'|t }}</h2>
        <p>{{ section_description|default('')|trim ?: 'Latest Gazettes'|t }}</p>
      </div>
      <a href="{{ path('view.resource_library.page_gazettes') }}">{{ 'View all Gazettes'|t }} <span aria-hidden="true">→</span></a>
    </header>
    {% if items %}
      <ul class="gazette-quicklinks" aria-label="{{ 'Latest Gazettes'|t }}">
        {% for item in items|slice(0, 5) %}
          <li class="gazette-quicklink">
            <span class="gazette-quicklink__icon" aria-hidden="true">
              <svg viewBox="0 0 40 48" width="40" height="48" fill="none" focusable="false">
                <path d="M7 2h17l9 9v33H7z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                <path d="M24 2v10h9" stroke="currentColor" stroke-width="2.5"/>
                <rect x="1" y="23" width="38" height="17" rx="3" fill="currentColor"/>
                <text x="20" y="35" fill="white" font-family="Arial, sans-serif" font-size="12" font-weight="700" text-anchor="middle">PDF</text>
              </svg>
            </span>
            <div class="gazette-quicklink__copy">
              {% if item.date %}
                <time class="gazette-quicklink__date" datetime="{{ item.datetime }}">{{ item.date }}</time>
              {% endif %}
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
            </div>
            <a class="gazette-quicklink__action" href="{{ item.pdf }}" target="_blank" rel="noopener noreferrer" data-gazette-preview data-gazette-title="{{ item.title }}" aria-haspopup="dialog">
              {{ 'Preview PDF'|t }}<span class="visually-hidden">: {{ item.title }}</span> <span aria-hidden="true">↗</span>
            </a>
          </li>
        {% endfor %}
      </ul>
      {% include '@ob/templates/content/pdf-preview.html.twig' with {preview_id: 'gazette-viewer-title'} only %}
    {% else %}
      <p>{{ 'Gazette publications will appear here when available.'|t }}</p>
    {% endif %}
  </div>
</section>
