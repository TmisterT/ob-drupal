{{ attach_library('ob/gazette-slider') }}
<section class="homepage-explore gazette-section" aria-labelledby="homepage-explore-title" data-gazette-slider data-pdf-preview-group>
  <div class="container">
    <header class="gazette-section__heading">
      <div>
        <span class="homepage-section__eyebrow">{{ section_label|default('')|trim ?: 'Official publications'|t }}</span>
        <h2 id="homepage-explore-title">{{ section_heading|default('')|trim ?: 'Information for the public'|t }}</h2>
        <p>{{ section_description|default('')|trim ?: 'Latest Gazettes'|t }}</p>
      </div>
      <a href="{{ path('view.resource_library.page_gazettes') }}">{{ 'View all Gazettes'|t }} <span aria-hidden="true">→</span></a>
    </header>
    {% if items %}
      <div class="gazette-section__controls" data-gazette-controls hidden>
        <button type="button" data-gazette-prev aria-label="{{ 'Previous Gazettes'|t }}" aria-controls="homepage-gazettes">←</button>
        <button type="button" data-gazette-next aria-label="{{ 'Next Gazettes'|t }}" aria-controls="homepage-gazettes">→</button>
      </div>
      <ul class="gazette-slider" tabindex="0" id="homepage-gazettes" aria-label="{{ 'Latest Gazettes'|t }}">
        {% for item in items %}
          <li class="gazette-card">
            <a class="gazette-card__cover" href="{{ item.pdf }}" data-gazette-preview data-gazette-title="{{ item.title }}" aria-label="{{ 'View PDF: @title'|t({'@title': item.title}) }}">
              <span class="gazette-card__paper" aria-hidden="true">
                <svg class="gazette-card__pdf-icon" viewBox="0 0 80 96" fill="none" focusable="false">
                  <path d="M18 6h29l17 17v63a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4Z" fill="#fff" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M47 6v13a4 4 0 0 0 4 4h13" fill="#fff1f2" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M25 36h28M25 44h20" stroke="currentColor" stroke-opacity=".25" stroke-width="2.5" stroke-linecap="round"/>
                  <rect x="8" y="56" width="62" height="26" rx="5" fill="currentColor"/>
                  <g stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 75V64h4a3 3 0 0 1 0 6h-4M34 64v11h3a5.5 5.5 0 0 0 0-11h-3ZM49 75V64h7M49 69h6"/>
                  </g>
                </svg>
              </span>
            </a>
            <div class="gazette-card__body">
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
              <div class="gazette-card__actions">
                <a href="{{ item.pdf }}" data-gazette-preview data-gazette-title="{{ item.title }}">{{ 'View'|t }}<span class="visually-hidden">: {{ item.title }}</span></a>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
      {% include '@ob/templates/content/pdf-preview.html.twig' with {preview_id: 'gazette-viewer-title'} only %}
    {% else %}
      <p>{{ 'Gazette publications will appear here when available.'|t }}</p>
    {% endif %}
  </div>
</section>
