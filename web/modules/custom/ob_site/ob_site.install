/**
 * Adds the administrator-managed public notices heading to the homepage.
 */
function ob_site_ensure_homepage_notices_heading(): void {
  if (!NodeType::load('homepage')) {
    return;
  }

  $field_name = 'field_notices_heading';
  $default_heading = 'Important Public Notices';

  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => ['max_length' => 160],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'homepage', $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => 'homepage',
      'label' => 'Public notices section heading',
      'description' => 'Heading displayed above public notices on the homepage.',
      'required' => TRUE,
      'default_value' => [['value' => $default_heading]],
    ])->save();
  }

  EntityFormDisplay::load('node.homepage.default')?->setComponent($field_name, [
    'type' => 'string_textfield',
    'weight' => 11,
    'region' => 'content',
    'settings' => [],
  ])->save();

  EntityViewDisplay::load('node.homepage.default')?->setComponent($field_name, [
    'type' => 'string',
    'weight' => 11,
    'region' => 'content',
    'label' => 'hidden',
    'settings' => [],
  ])->save();

  $homepages = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'homepage']);
  foreach ($homepages as $homepage) {
    if (!$homepage->get($field_name)->isEmpty()) {
      continue;
    }

    $homepage->set($field_name, $default_heading);
    $homepage->setNewRevision(TRUE);
    $homepage->setRevisionLogMessage('Add the homepage public notices heading.');
    $homepage->save();
  }
}

