    foreach ($definition['fields'] as $field_name => $field_definition) {
      if (!FieldStorageConfig::loadByName('block_content', $field_name)) {
        FieldStorageConfig::create([
          'field_name' => $field_name,
          'entity_type' => 'block_content',
          'type' => $field_definition['type'],
          'settings' => $field_definition['storage_settings'] ?? [],
          'cardinality' => $field_definition['cardinality'] ?? 1,
          'translatable' => TRUE,
        ])->save();
      }

      if (!FieldConfig::loadByName('block_content', $bundle, $field_name)) {
        FieldConfig::create([
          'field_name' => $field_name,
          'entity_type' => 'block_content',
          'bundle' => $bundle,
          'label' => $field_definition['label'],
          'description' => $field_definition['description'] ?? '',
          'required' => $field_definition['required'] ?? FALSE,
          'default_value' => $field_definition['default_value'] ?? [],
          'settings' => $field_definition['settings'] ?? [],
        ])->save();
      }

      $form_display->setComponent($field_name, [
        'type' => $field_definition['widget'],
        'weight' => $weight,
        'region' => 'content',
        'settings' => $field_definition['widget_settings'] ?? [],
      ]);
      $view_display->setComponent($field_name, [
        'type' => $field_definition['formatter'],
        'weight' => $weight,
        'region' => 'content',
        'label' => 'hidden',
        'settings' => $field_definition['formatter_settings'] ?? [],
      ]);
      $weight++;
    }

    $form_display->save();
    $view_display->save();
  }

  $menus = [
    'utility' => 'Utility navigation',
    'footer-government' => 'Footer government links',
    'footer-services' => 'Footer service links',
    'legal' => 'Legal navigation',
    'social' => 'Social links',
  ];
  foreach ($menus as $id => $label) {
    if (!Menu::load($id)) {
      Menu::create(['id' => $id, 'label' => $label])->save();
    }
  }

  $utility_links = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties([
    'menu_name' => 'utility',
    'title' => 'Search',
  ]);
  if (!$utility_links) {
    MenuLinkContent::create([
      'title' => 'Search',
      'menu_name' => 'utility',
      'link' => ['uri' => 'internal:/search/node'],
      'enabled' => TRUE,
      'weight' => 0,
    ])->save();
  }

  $starter_footer_links = [
    ['footer-government', 'Home', 'internal:/'],
    ['footer-services', 'Find services', 'internal:/search/node?keys=services'],
  ];
  foreach ($starter_footer_links as [$menu_name, $title, $uri]) {
    $links = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties([
      'menu_name' => $menu_name,
      'title' => $title,
    ]);
    if (!$links) {
      MenuLinkContent::create([
        'title' => $title,
        'menu_name' => $menu_name,
        'link' => ['uri' => $uri],
        'enabled' => TRUE,
        'weight' => 0,
      ])->save();
    }
  }

  $block_storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $identity_blocks = $block_storage->loadByProperties([
    'type' => 'government_identity',
    'info' => 'Kiribati Government website identity',
  ]);
  $identity = $identity_blocks ? reset($identity_blocks) : BlockContent::create([
    'type' => 'government_identity',
    'info' => 'Kiribati Government website identity',
    'status' => TRUE,
    'reusable' => TRUE,
    'field_label' => 'A Kiribati Government Website',
  ]);
  $identity_changed = $identity->isNew();
  if ($identity->get('field_logo')->isEmpty()) {
    $logo_matches = Drupal::entityTypeManager()->getStorage('media')->loadByProperties([
      'bundle' => 'image',
      'name' => 'Government of Kiribati logo',
    ]);
    $logo = $logo_matches ? reset($logo_matches) : NULL;
    $source_path = DRUPAL_ROOT . '/themes/custom/ob/src/assets/images/ob-government-mark.png';
    if (!$logo && is_file($source_path)) {
      $directory = 'public://branding';
      Drupal::service('file_system')->prepareDirectory(
        $directory,
        FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
      );
      $file = Drupal::service('file.repository')->writeData(
        file_get_contents($source_path),
        $directory . '/ob-government-mark.png',
        FileExists::Replace,
      );
      $logo = Media::create([
        'bundle' => 'image',
        'name' => 'Government of Kiribati logo',
        'status' => TRUE,
        'uid' => 1,
        'field_media_image' => [
          'target_id' => $file->id(),
          'alt' => 'Government of Kiribati logo',
        ],
      ]);
      $logo->save();
    }
    if ($logo) {
      $identity->set('field_logo', ['target_id' => $logo->id()]);
      $identity_changed = TRUE;
    }
  }
  if ($identity->get('field_office_name')->isEmpty()) {
    $identity->set('field_office_name', \Drupal::config('system.site')->get('name') ?: 'Office of Te Beretitenti');
    $identity_changed = TRUE;
  }
  if ($identity->get('field_government_name')->isEmpty()) {
    $identity->set('field_government_name', 'Government of Kiribati');
    $identity_changed = TRUE;
  }
  if ($identity->get('field_home_link')->isEmpty()) {
    $identity->set('field_home_link', ['uri' => 'internal:/']);
    $identity_changed = TRUE;
  }
  if ($identity_changed) {
    $identity->save();
  }

  $about_blocks = $block_storage->loadByProperties([
    'type' => 'footer_about',
    'info' => 'Footer about OB',
  ]);
  $footer_about = $about_blocks ? reset($about_blocks) : BlockContent::create([
    'type' => 'footer_about',
    'info' => 'Footer about OB',
    'status' => TRUE,
    'reusable' => TRUE,
    'body' => [
      'value' => '<p>Official information from the Office of Te Beretitenti, Government of Kiribati.</p>',
      'format' => 'basic_html',
    ],
  ]);
  if ($footer_about->isNew()) {
    $footer_about->save();
  }

  $contact_blocks = $block_storage->loadByProperties([
    'type' => 'contact_details',
    'info' => 'Footer contact details',
  ]);
  $footer_contact = $contact_blocks ? reset($contact_blocks) : BlockContent::create([
    'type' => 'contact_details',
    'info' => 'Footer contact details',
    'status' => TRUE,
    'reusable' => TRUE,
    'field_address' => [
      'value' => '<p>Office of Te Beretitenti<br>Bairiki, Tarawa<br>Republic of Kiribati</p>',
      'format' => 'basic_html',
    ],
  ]);
  if ($footer_contact->isNew()) {
    $footer_contact->save();
  }

  $region_migrations = [
    'ob_branding' => 'branding',
    'ob_main_menu' => 'primary_menu',
    'ob_breadcrumbs' => 'highlighted',
    'ob_local_actions' => 'highlighted',
    'ob_messages' => 'highlighted',
    'ob_page_title' => 'highlighted',
    'ob_content' => 'content',
    'ob_footer' => 'footer_navigation',
  ];
  foreach ($region_migrations as $block_id => $region) {
    if ($block = Block::load($block_id)) {
      $block->setRegion($region);
      if ($block_id === 'ob_footer') {
        $block->setStatus(FALSE);
      }
      if ($block_id === 'ob_branding') {
        $block->setStatus(FALSE);
      }
      $block->save();
    }
  }

  ob_site_place_block(
    'ob_government_identity',
    'block_content:' . $identity->uuid(),
    'utility',
    -20,
    'Government website identity',
  );
  ob_site_place_block(
    'ob_utility_menu',
    'system_menu_block:utility',
    'utility',
    0,
    'Utility navigation',
  );
  ob_site_place_block(
    'ob_site_identity',
    'block_content:' . $identity->uuid(),
    'branding',
    0,
    'Government site identity',
  );
  ob_site_place_block(
    'ob_footer_about',
    'block_content:' . $footer_about->uuid(),
    'footer_about',
    0,
    'About the Office',
  );
  ob_site_place_block(
    'ob_footer_contact',
    'block_content:' . $footer_contact->uuid(),
    'footer_contact',
    0,
    'Contact',
  );
  ob_site_place_block('ob_footer_government', 'system_menu_block:footer-government', 'footer_navigation', 0, 'Government');
  ob_site_place_block('ob_footer_services', 'system_menu_block:footer-services', 'footer_navigation', 10, 'Services');
  ob_site_place_block('ob_legal_menu', 'system_menu_block:legal', 'footer_bottom', 0, 'Legal');
  ob_site_place_block('ob_social_menu', 'system_menu_block:social', 'footer_bottom', 10, 'Social links');

  \Drupal::service('config.factory')
    ->getEditable('ob.settings')
    ->set('logo.use_default', FALSE)
    ->set('logo.path', 'themes/custom/ob/src/assets/images/ob-government-mark.svg')
    ->save();
}

/**
 * Creates or updates a block placement for the OB theme.
 */
function ob_site_place_block(string $id, string $plugin, string $region, int $weight, string $label): void {
  $block = Block::load($id) ?? Block::create([
    'id' => $id,
    'theme' => 'ob',
    'plugin' => $plugin,
    'status' => TRUE,
  ]);
  $block->setRegion($region);
  $block->setWeight($weight);
  $is_menu = str_starts_with($plugin, 'system_menu_block:');
  $settings = [
    'id' => $plugin,
    'label' => $label,
    'label_display' => in_array($id, ['ob_footer_government', 'ob_footer_services'], TRUE),
    'provider' => $is_menu ? 'system' : 'block_content',
  ];
  if ($is_menu) {
    $settings += [
      'level' => 1,
      'depth' => 0,
      'expand_all_items' => FALSE,
    ];
  }
  else {
    $settings['view_mode'] = 'full';
  }
  $block->set('settings', $settings);
  $block->save();
}

/**
 * Creates image styles and the responsive homepage hero display.
 */
function ob_site_ensure_image_styles(): void {
  $styles = [
    'ob_hero_large' => ['OB hero large', 1600, 720],
    'ob_hero_medium' => ['OB hero medium', 960, 600],
    'ob_hero_small' => ['OB hero small', 640, 640],
    'ob_card' => ['OB content card', 720, 480],
    'ob_profile' => ['OB profile portrait', 480, 600],
    'ob_publication_cover' => ['OB publication cover', 480, 680],
  ];

  foreach ($styles as $id => [$label, $width, $height]) {
    if (!ImageStyle::load($id)) {
      $style = ImageStyle::create(['name' => $id, 'label' => $label]);
      $style->addImageEffect([
        'id' => 'image_scale_and_crop',
        'weight' => 0,
        'data' => [
          'width' => $width,
          'height' => $height,
          'anchor' => 'center-center',
        ],
      ]);
      $style->save();
    }
  }

  if (!ResponsiveImageStyle::load('ob_hero')) {
    ResponsiveImageStyle::create([
      'id' => 'ob_hero',
      'label' => 'OB homepage hero',
      'breakpoint_group' => 'responsive_image',
      'fallback_image_style' => 'ob_hero_small',
      'image_style_mappings' => [[
        'image_mapping_type' => 'sizes',
        'image_mapping' => [
          'sizes' => '(min-width: 1200px) 50vw, (min-width: 768px) 55vw, 100vw',
          'sizes_image_styles' => ['ob_hero_large', 'ob_hero_medium', 'ob_hero_small'],
        ],
        'breakpoint_id' => 'responsive_image.viewport_sizing',
        'multiplier' => '1x',
      ]],
    ])->save();
  }

  if (!EntityViewMode::load('media.homepage_hero')) {
    EntityViewMode::create([
      'id' => 'media.homepage_hero',
      'label' => 'Homepage hero',
      'targetEntityType' => 'media',
      'status' => TRUE,
    ])->save();
  }

  $image_media_type = \Drupal::entityTypeManager()->getStorage('media_type')->load('image');
  if ($image_media_type) {
    $source_field = $image_media_type->getSource()->getConfiguration()['source_field'];
    $display = EntityViewDisplay::load('media.image.homepage_hero') ?? EntityViewDisplay::create([
      'targetEntityType' => 'media',
      'bundle' => 'image',
      'mode' => 'homepage_hero',
      'status' => TRUE,
    ]);
    $display->setComponent($source_field, [
      'type' => 'responsive_image',
      'label' => 'hidden',
      'region' => 'content',
      'settings' => [
        'responsive_image_style' => 'ob_hero',
        'image_link' => '',
      ],
    ]);
    foreach (['created', 'name', 'thumbnail', 'uid'] as $component) {
      $display->removeComponent($component);
    }
    $display->save();
  }

  $homepage_display = EntityViewDisplay::load('node.homepage.default');
  if ($homepage_display && $homepage_display->getComponent('field_hero_image')) {
    $homepage_display->setComponent('field_hero_image', [
      'type' => 'entity_reference_entity_view',
      'weight' => 3,
      'region' => 'content',
      'label' => 'hidden',
      'settings' => [
        'view_mode' => 'homepage_hero',
        'link' => FALSE,
      ],
    ])->save();
  }
}



