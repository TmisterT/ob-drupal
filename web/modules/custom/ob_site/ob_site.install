}

/**
 * Standardize existing homepage slide action labels.
 */
function ob_site_update_11021(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'homepage_slide')
    ->exists('field_slide_link.uri')
    ->execute();

  foreach ($storage->loadMultiple($ids) as $slide) {
    if ($slide->get('field_slide_link')->isEmpty()) {
      continue;
    }

    $link = $slide->get('field_slide_link')->first();
    if ($link->title === 'Click more') {
      continue;
    }

    $link->title = 'Click more';
    $slide->setNewRevision(TRUE);
    $slide->setRevisionLogMessage('Standardize the homepage slide action label.');
    $slide->save();
  }
}

