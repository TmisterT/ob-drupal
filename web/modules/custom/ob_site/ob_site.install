/**
 * Add an administrator-controlled visibility switch for public alerts.
 */
function ob_site_update_11019(): void {
  ob_site_ensure_global_structure();

  $alert_blocks = \Drupal::entityTypeManager()->getStorage("block_content")->loadByProperties([
    "type" => "sitewide_alert",
    "info" => "Sitewide public alert",
  ]);
  if ($alert_blocks) {
    $alert = reset($alert_blocks);
    if ($alert->get("field_alert_enabled")->isEmpty()) {
      $alert->set("field_alert_enabled", FALSE)->save();
    }
  }

  $placement = Block::load("ob_sitewide_alert");
  if ($placement) {
    $placement->setRegion("alerts")->setStatus(TRUE)->save();
  }
}


