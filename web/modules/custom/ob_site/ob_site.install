/**
 * Implements hook_install().
 */
function ob_site_install(): void {
  if (!NodeType::load('homepage')) {
    NodeType::create([
      'type' => 'homepage',
      'name' => 'Homepage',
      'description' => 'Controls the content displayed on the website home page.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'field_hero_label' => [
      'label' => 'Hero label',
      'description' => 'Short context shown above the hero title, for example “Government update”.',
      'type' => 'string',
      'storage_settings' => ['max_length' => 120],
      'required' => FALSE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
    ],
    'field_hero_title' => [
      'label' => 'Hero title',
      'description' => 'The main public announcement or homepage message.',
      'type' => 'string',
      'storage_settings' => ['max_length' => 255],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
    ],
    'field_hero_summary' => [
      'label' => 'Hero summary',
      'description' => 'A concise explanation supporting the hero title.',
      'type' => 'text_long',
      'required' => FALSE,
      'widget' => 'text_textarea',
      'widget_settings' => ['rows' => 4],
      'formatter' => 'text_default',
    ],
    'field_hero_image' => [
      'label' => 'Hero image',
      'description' => 'Use a wide, high-quality image with a meaningful alternative text.',
      'type' => 'entity_reference',
      'storage_settings' => ['target_type' => 'media'],
      'settings' => [
        'handler' => 'default:media',
        'handler_settings' => [
          'target_bundles' => ['image' => 'image'],
          'sort' => ['field' => '_none', 'direction' => 'ASC'],
          'auto_create' => FALSE,
          'auto_create_bundle' => NULL,
        ],
      ],
      'required' => FALSE,
      'widget' => 'media_library_widget',
      'formatter' => 'entity_reference_entity_view',
      'formatter_settings' => ['view_mode' => 'default', 'link' => FALSE],
    ],
    'field_hero_link' => [
      'label' => 'Hero action',
      'description' => 'Enter both the button text and its destination.',
      'type' => 'link',
      'settings' => ['title' => 2, 'link_type' => 17],
      'required' => FALSE,
      'widget' => 'link_default',
      'formatter' => 'link',
      'formatter_settings' => ['trim_length' => 80, 'url_only' => FALSE, 'url_plain' => FALSE, 'rel' => '', 'target' => ''],
    ],
    'field_search_heading' => [
      'label' => 'Search heading',
      'type' => 'string',
      'storage_settings' => ['max_length' => 160],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'What are you looking for?']],
    ],
    'field_search_placeholder' => [
      'label' => 'Search placeholder',
      'type' => 'string',
      'storage_settings' => ['max_length' => 255],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'Search OB information, services and publications…']],
    ],
    'field_quick_links' => [
      'label' => 'Homepage quick links',
      'description' => 'Add up to four prominent links. The link title is displayed on the card.',
      'type' => 'link',
      'settings' => ['title' => 2, 'link_type' => 17],
      'cardinality' => 4,
      'required' => FALSE,
      'widget' => 'link_default',
      'formatter' => 'link',
      'formatter_settings' => ['trim_length' => 80, 'url_only' => FALSE, 'url_plain' => FALSE, 'rel' => '', 'target' => ''],
    ],
    'field_updates_heading' => [
      'label' => 'Updates section heading',
      'type' => 'string',
      'storage_settings' => ['max_length' => 160],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'Latest updates']],
    ],
    'field_services_heading' => [
      'label' => 'Services section heading',
      'type' => 'string',
      'storage_settings' => ['max_length' => 160],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'Services & information']],
    ],
    'field_activities_heading' => [
      'label' => 'Activities section heading',
      'type' => 'string',
      'storage_settings' => ['max_length' => 160],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'Te Beretitenti / Official activities']],
    ],
    'field_projects_heading' => [
      'label' => 'Projects section heading',
      'type' => 'string',
      'storage_settings' => ['max_length' => 160],
      'required' => TRUE,
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'default_value' => [['value' => 'Projects & initiatives']],
    ],
  ];

  $form_display = EntityFormDisplay::load('node.homepage.default') ?? EntityFormDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => 'homepage',
    'mode' => 'default',
    'status' => TRUE,
  ]);

  $view_display = EntityViewDisplay::load('node.homepage.default') ?? EntityViewDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => 'homepage',
    'mode' => 'default',
    'status' => TRUE,
  ]);

  $form_display
    ->setComponent('title', [
      'type' => 'string_textfield',
      'weight' => -10,
      'region' => 'content',
      'settings' => ['size' => 60, 'placeholder' => ''],
    ])
    ->setComponent('status', [
      'type' => 'boolean_checkbox',
      'weight' => 100,
      'region' => 'content',
      'settings' => ['display_label' => TRUE],
    ]);

  $weight = 0;
  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage_settings'] ?? [],
        'cardinality' => $definition['cardinality'] ?? 1,
        'translatable' => TRUE,
      ])->save();
    }

    if (!FieldConfig::loadByName('node', 'homepage', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'homepage',
        'label' => $definition['label'],
        'description' => $definition['description'] ?? '',
        'required' => $definition['required'],
        'settings' => $definition['settings'] ?? [],
        'default_value' => $definition['default_value'] ?? [],
      ])->save();
    }

    $form_display->setComponent($field_name, [
      'type' => $definition['widget'],
      'weight' => $weight,
      'region' => 'content',
      'settings' => $definition['widget_settings'] ?? [],
    ]);

    $view_display->setComponent($field_name, [
      'type' => $definition['formatter'],
      'weight' => $weight,
      'region' => 'content',
      'label' => 'hidden',
      'settings' => $definition['formatter_settings'] ?? [],
    ]);

    $weight++;
  }

  $form_display->save();
  $view_display->save();
  ob_site_grant_public_search_permission();
  ob_site_ensure_global_structure();
  ob_site_ensure_image_styles();
  ob_site_ensure_taxonomies();
  ob_site_remove_unused_default_tags();
  ob_site_ensure_page_content_types();
  ob_site_ensure_homepage_presentation_fields();
  ob_site_ensure_homepage_notices_heading();
  ob_site_ensure_initial_landing_pages();
  ob_site_ensure_quick_access_destinations();
  ob_site_ensure_information_for_public_destinations();
  ob_site_ensure_public_notices();
  ob_site_ensure_homepage_slider();
  ob_site_ensure_homepage_public_features();
  ob_site_ensure_service_content_types();
}

/**
 * Add administrator-managed quick links to the Homepage content type.
 */
function ob_site_update_11001(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_quick_links')) {
    FieldStorageConfig::create([
      'field_name' => 'field_quick_links',
      'entity_type' => 'node',
      'type' => 'link',
      'cardinality' => 4,
      'translatable' => TRUE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'homepage', 'field_quick_links')) {
    FieldConfig::create([
      'field_name' => 'field_quick_links',
      'entity_type' => 'node',
      'bundle' => 'homepage',
      'label' => 'Homepage quick links',
      'description' => 'Add up to four prominent links. The link title is displayed on the card.',
      'required' => FALSE,
      'settings' => ['title' => 2, 'link_type' => 17],
    ])->save();
  }

  $form_display = EntityFormDisplay::load('node.homepage.default');
  $form_display?->setComponent('field_quick_links', [
    'type' => 'link_default',
    'weight' => 7,
    'region' => 'content',
    'settings' => ['placeholder_url' => '', 'placeholder_title' => ''],
  ])->save();

  $view_display = EntityViewDisplay::load('node.homepage.default');
  $view_display?->setComponent('field_quick_links', [
    'type' => 'link',
    'weight' => 7,
    'region' => 'content',
    'label' => 'hidden',
    'settings' => ['trim_length' => 80, 'url_only' => FALSE, 'url_plain' => FALSE, 'rel' => '', 'target' => ''],
  ])->save();
}

/**
 * Allow visitors to use the public content search.
 */
function ob_site_update_11002(): void {
  ob_site_grant_public_search_permission();
}

/**
 * Grants content-search access to public site roles.
 */
function ob_site_grant_public_search_permission(): void {
  foreach (['anonymous', 'authenticated'] as $role_id) {
    $role = Role::load($role_id);
    if ($role && !$role->hasPermission('search content')) {
      $role->grantPermission('search content')->save();
    }
  }
}

