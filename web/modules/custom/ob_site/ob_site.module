<?php

declare(strict_types=1);

use Drupal\views\Views;

/**
 * Implements hook_preprocess_node().
 */
function ob_site_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node || $node->bundle() !== 'homepage' || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  $view = Views::getView('homepage_hero_slider');
  if ($view) {
    $view->setDisplay('block_1');
    $variables['homepage_slider'] = $view->render();
  }

  $board = ob_site_official_updates();
  $variables['official_updates'] = $board['items'];
  $variables['official_updates_cache'] = ['#markup' => ''];
  $board['cache']->applyTo($variables['official_updates_cache']);
  $board['cache']->applyTo($variables['elements']);
  $president_view = Views::getView('current_president');

  if ($president_view) {
    $president_view->setDisplay('block_1');
    $variables['current_president'] = $president_view->render();
  }
}

/**
 * Combines active notices with the existing featured News/Press release View.
 */
function ob_site_official_updates(): array {
  $cache = (new \Drupal\Core\Cache\CacheableMetadata())
    ->addCacheTags(['node_list:public_notice', 'node_list:update', 'config:views.view.homepage_featured_updates'])
    ->addCacheContexts(['user.permissions', 'user.node_grants:view', 'languages:language_content', 'languages:language_interface', 'timezone'])
    ->setCacheMaxAge(3600);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $today = \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'custom', 'Y-m-d');
  $timezone = new \DateTimeZone(date_default_timezone_get());
  $midnight = (new \DateTimeImmutable($today, $timezone))->modify('+1 day')->getTimestamp();
  $cache->addCacheTags(['config:system.date']);
  $cache->setCacheMaxAge(min(3600, max(1, $midnight - \Drupal::time()->getRequestTime())));
  $query = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'public_notice')->condition('status', 1);
  $expiry = $query->orConditionGroup()->notExists('field_notice_expiry')->condition('field_notice_expiry.value', $today, '>=');
  $ids = $query->condition($expiry)->sort('field_notice_urgent.value', 'DESC')->sort('field_notice_date.value', 'DESC')->sort('nid', 'DESC')->range(0, 3)->execute();
  $nodes = array_values($storage->loadMultiple($ids));
  $view = Views::getView('homepage_featured_updates');
  if ($view) {
    $cache->addCacheableDependency($view->storage);
    $view->setDisplay('block_1');
    $view->execute();
    foreach ($view->result as $row) {
      if ($row->_entity) {
        $nodes[] = $row->_entity;
      }
    }
  }
  $items = [];
  $seen = [];
  foreach ($nodes as $node) {
    if (isset($seen[$node->id()])) {
      continue;
    }
    $seen[$node->id()] = TRUE;
    $node = \Drupal::service('entity.repository')->getTranslationFromContext($node);
    if ($node->bundle() === 'update' && (!$node->isPublished() || !$node->access('view'))) {
      // Prefer the page language, then an available published translation.
      foreach ($node->getUntranslated()->getTranslationLanguages() as $language) {
        $translation = $node->getTranslation($language->getId());
        if ($translation->isPublished() && $translation->access('view')) {
          $node = $translation;
          break;
        }
      }
    }
    $access = $node->access('view', NULL, TRUE);
    $cache->addCacheableDependency($node)->addCacheableDependency($access);
    if (!$node->isPublished() || !$access->isAllowed()) {
      continue;
    }
    $notice = $node->bundle() === 'public_notice';
    $categories = [];
    $detail = !$notice;
    foreach ($node->get($notice ? 'field_notice_category' : 'field_update_type')->referencedEntities() as $category) {
      $category_key = strtolower(trim($category->getUntranslated()->label()));
      $category = \Drupal::service('entity.repository')->getTranslationFromContext($category);
      $cache->addCacheableDependency($category);
      $categories[] = $category->label();
      if (in_array($category_key, ['announcement', 'announcements', 'public holiday', 'public holidays'], TRUE)) {
        $detail = TRUE;
      }
    }
    $url = $detail ? $node->toUrl() : NULL;
    if ($notice && !$detail && !$node->get('field_notice_link')->isEmpty()) {
      $url = $node->get('field_notice_link')->first()->getUrl();
    }
    $image = NULL;
    if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
      $media = $node->get('field_featured_image')->entity;
      if ($media) {
        $media_access = $media->access('view', NULL, TRUE);
        $cache->addCacheableDependency($media)->addCacheableDependency($media_access);
        if ($media_access->isAllowed()) {
          $image = $node->get('field_featured_image')->view(['label' => 'hidden', 'type' => 'entity_reference_entity_view', 'settings' => ['view_mode' => 'default', 'link' => FALSE]]);
        }
      }
    }
    $date = $node->get($notice ? 'field_notice_date' : 'field_update_date')->value;
    $documents = [];
    if ($notice && $node->hasField('field_documents')) {
      foreach ($node->get('field_documents')->referencedEntities() as $media) {
        $media_access = $media->access('view', NULL, TRUE);
        $cache->addCacheableDependency($media)->addCacheableDependency($media_access);
        if ($media_access->isAllowed()) {
          $documents[] = \Drupal::entityTypeManager()->getViewBuilder('media')->view($media);
        }
      }
    }
    $items[] = [
      'id' => $node->id(), 'title' => $node->label(),
      'summary' => $node->get($notice ? 'field_notice_summary' : 'field_summary')->value,
      'category' => implode(', ', $categories) ?: ($notice ? t('Public notice') : t('News / Press release')),
      'datetime' => $date,
      'date' => $date ? \Drupal::service('date.formatter')->format(strtotime($date), 'custom', 'j F Y') : NULL,
      'urgent' => $notice && (bool) $node->get('field_notice_urgent')->value,
      'image' => $image, 'documents' => $documents, 'url' => $url, 'notice' => $notice,
      'link_label' => $notice && !$detail ? t('View related information') : t('Read more'),
    ];
  }
  usort($items, static fn(array $a, array $b): int => ($b['urgent'] <=> $a['urgent']) ?: strcmp($b['datetime'] ?? '', $a['datetime'] ?? '') ?: ((int) $b['id'] <=> (int) $a['id']));
  return ['items' => $items, 'cache' => $cache];
}

require_once __DIR__ . '/includes/bilingual.module.inc';

/**
 * Makes the existing board heading easy to find on Homepage edit forms.
 */
function ob_site_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\Core\Entity\EntityFormInterface) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof \Drupal\node\NodeInterface || $entity->bundle() !== 'homepage' || !isset($form['field_notices_heading'])) {
    return;
  }
  $form['official_updates_settings'] = [
    '#type' => 'fieldset',
    '#title' => t('Official updates board'),
    '#description' => t('Change the heading above the public notices, announcements, news and press releases on the homepage.'),
    '#weight' => -8,
  ];
  // Group the existing widget without moving it or changing its saved value.
  $form['field_notices_heading']['#group'] = 'official_updates_settings';
  $form['field_notices_heading']['#weight'] = 0;
}

require_once __DIR__ . '/includes/news-resources.module.inc';

/**
 * Implements hook_user_login().
 */
function ob_site_user_login(\Drupal\user\UserInterface $account): void {
  \Drupal::messenger()->addStatus(t('Welcome, @name. You are signed in.', ['@name' => $account->getDisplayName()]));
}

require_once __DIR__ . '/includes/activity.module.inc';

/**
 * Implements hook_theme().
 */
function ob_site_theme(): array {
  return [
    'ob_site_website_activity' => [
      'variables' => [
        'filters' => [], 'users' => [], 'types' => [], 'summary' => [],
        'events' => [], 'active_users' => [], 'health' => [], 'pager' => [],
        'started' => NULL, 'retention' => NULL, 'logging_available' => FALSE,
      ],
    ],
  ];
}
